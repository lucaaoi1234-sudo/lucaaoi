# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# Các biến không có tiền tố NEXT_PUBLIC_ chỉ được đọc trên server, không bao giờ gửi xuống trình duyệt.

# Chuỗi kết nối PostgreSQL (khớp với docker-compose.yml)
DATABASE_URL="postgresql://aimforge:aimforge_dev_password@localhost:5432/aimforge?schema=public"

# Khóa ký phiên đăng nhập (JWT HS256). Tối thiểu 32 ký tự ngẫu nhiên.
# Tạo nhanh: openssl rand -base64 48
AUTH_SECRET="replace-with-at-least-32-random-characters-xxxxxxxx"

# Thời hạn phiên đăng nhập (ngày). Mặc định 7.
SESSION_TTL_DAYS=7

# Đặt "true" để bắt buộc cookie Secure (mặc định bật khi NODE_ENV=production).
# COOKIE_SECURE=true
